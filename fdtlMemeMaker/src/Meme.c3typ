entity type Meme {
  caption: !string
  category: !string enum('Wholesome', 'Cursed', 'DeepFried')
  status: string enum('Draft', 'Published', 'Archived') = "Draft"
  postedAt: !datetime
  author: MemeAuthor
  template: MemeTemplate
  customImageUrl: string

  frontPageMemes: function(): [Meme] js
  exportJson: member function(): json js
  importJson: function(data: json): Meme js
}
